        <tr>
            <td> <a href="/worker/{{worker._id}}"> {{ worker.workerid }} </a> </td>  
           <td> {{ worker.firstname }} {{worker.lastname}} </td>
        </tr>

      @endeach
    </table> 
              
     </div>
</div>

